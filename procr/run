#!/bin/bash

# PROCR Server Run Script
# Launches PROCR transaction processor with structured logging
# Logging: ./log/procr/yyyy/MMM/dd/procr-yyyyMMdd-HHmmss-i.log (5MB rollover, no compression)
# Port: 8080 (or override with PORT env var)

set -e

PORT="${PORT:-8080}"
JAR_FILE="target/procr-transaction-processor-1.0.0.jar"

# Validate JAR exists
if [ ! -f "$JAR_FILE" ]; then
    echo "❌ Error: JAR file not found at $JAR_FILE"
    echo "Please run: cd procr && ./build"
    exit 1
fi

# Create log directory
mkdir -p log/procr

echo "🚀 Starting PROCR Server (port $PORT)"
echo "📁 Logging to: ./log/procr/yyyy/MMM/dd/"
echo ""

# Launch with Java - logback-spring.xml auto-loaded from classpath
java \
    -Dspring.profiles.active=production \
    -Dserver.port="$PORT" \
    -Dlogging.config="classpath:logback-spring.xml" \
    -jar "$JAR_FILE"

echo "✅ PROCR Server stopped"


