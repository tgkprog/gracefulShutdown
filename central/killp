#!/bin/bash

# Kill Central Server on ports 5000 (HTTP API) and 5009 (TCP)
PORTS=(5000 5009)
COMPONENT="Central Server"

echo "🔍 Searching for $COMPONENT on ports: ${PORTS[@]}..."

# Find all processes using the specified ports
PIDS=()
for PORT in "${PORTS[@]}"; do
    PID=$(lsof -ti :$PORT 2>/dev/null | head -1)
    if [ -n "$PID" ]; then
        PIDS+=($PID)
        echo "Found process on port $PORT: PID $PID"
    fi
done

if [ ${#PIDS[@]} -eq 0 ]; then
    echo "❌ No processes found on ports: ${PORTS[@]}"
    exit 1
fi

# Try to kill gracefully first
echo "Killing $COMPONENT processes (PIDs: ${PIDS[@]})..."
for PID in "${PIDS[@]}"; do
    kill -15 $PID 2>/dev/null
done

# Wait a bit
sleep 2

# Check if still running and force kill if needed
REMAINING_PIDS=()
for PID in "${PIDS[@]}"; do
    if kill -0 $PID 2>/dev/null; then
        REMAINING_PIDS+=($PID)
    fi
done

if [ ${#REMAINING_PIDS[@]} -gt 0 ]; then
    echo "⚠️  Some processes still running, forcing kill..."
    for PID in "${REMAINING_PIDS[@]}"; do
        kill -9 $PID 2>/dev/null
    done
    sleep 1
fi

# Verify all killed
FAILED_PIDS=()
for PID in "${PIDS[@]}"; do
    if kill -0 $PID 2>/dev/null; then
        FAILED_PIDS+=($PID)
    fi
done

if [ ${#FAILED_PIDS[@]} -gt 0 ]; then
    echo "❌ Failed to kill processes: ${FAILED_PIDS[@]}"
    exit 1
else
    echo "✅ Successfully killed $COMPONENT on all ports (PIDs: ${PIDS[@]})"
fi
