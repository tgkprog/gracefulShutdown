#!/bin/bash

# Adapter Server Run Script
# Launches Adapter JSON/YAML converter with structured logging
# Logging: ./log/adapter/yyyy/MMM/dd/adapter-yyyyMMdd-HHmmss-i.log (5MB rollover, no compression)
# Port: 9090 (or override with PORT env var)

set -e

PORT="${PORT:-9090}"
JAR_FILE="target/adapter-service-1.0.0.jar"

# Validate JAR exists
if [ ! -f "$JAR_FILE" ]; then
    echo "❌ Error: JAR file not found at $JAR_FILE"
    echo "Please run: cd adapter && ./build"
    exit 1
fi

# Create log directory
mkdir -p log/adapter

echo "🚀 Starting Adapter Server (port $PORT)"
echo "📁 Logging to: ./log/adapter/yyyy/MMM/dd/"
echo ""

# Launch with Java - logback-spring.xml auto-loaded from classpath
java \
    -Dspring.profiles.active=production \
    -Dserver.port="$PORT" \
    -Dlogging.config="classpath:logback-spring.xml" \
    -jar "$JAR_FILE"

echo "✅ Adapter Server stopped"


